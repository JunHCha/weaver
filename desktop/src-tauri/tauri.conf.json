{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Weaver",
  "version": "0.1.0",
  "identifier": "dev.junhcha.weaver",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "Weaver", "width": 1280, "height": 860 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/weaver-server"],
    "resources": { "../../web/out/": "web/" },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": null
    }
  }
}
