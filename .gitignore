# 비공개 로컬 문서. 슬래시 없이 적어 워크트리의 심볼릭 링크도 함께 제외한다.
docs/domain
docs/research
docs/guides

# Python development artifacts
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
*.egg-info/

# Android build artifacts and machine-local SDK path
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
*.iml
*.apk
*.aab
*.idsig

# Signing material must never be committed (docs/guides/android-signing.md).
# The real key lives in ~/.config/weaver/android/; these guard accidental copies.
*.jks
*.keystore
*.p12
*.pk8
*.jks.enc
*.p12.enc
*.keystore.enc
keystore.properties
signing.properties
signing.env

# Generated local evaluation/test reports
/reports/
