{
  "$comment": "Weaver design tokens. Source of truth for CSS (index.html :root), Next.js and Android Compose. Light theme only. Lengths are px, durations are ms.",
  "color": {
    "bg": "#F2F3F0",
    "surface": "#FBFBF9",
    "line": "#D9DCD5",
    "ink": "#1D2330",
    "muted": "#646A73",
    "indigo": "#22346E",
    "thread": "#C7354B",
    "hover": {
      "hex": "#1D2330",
      "alpha": 0.045
    },
    "selected": {
      "hex": "#22346E",
      "alpha": 0.08
    },
    "kind": {
      "request": {
        "name": "치자",
        "hex": "#B8860B",
        "tintPercent": 6,
        "band": "solid"
      },
      "decision": {
        "name": "쪽",
        "hex": "#4A64A8",
        "tintPercent": 6,
        "band": "solid"
      },
      "schedule": {
        "name": "쑥",
        "hex": "#5B7A43",
        "tintPercent": 6,
        "band": "solid"
      },
      "record": {
        "name": "먹",
        "hex": "#5E6168",
        "tintPercent": 3,
        "band": "solid"
      },
      "hollow": {
        "name": "회색",
        "hex": "#9AA0A8",
        "tintPercent": 0,
        "band": "dashed",
        "applies": [
          "태그정정",
          "거절",
          "실행"
        ]
      }
    }
  },
  "typography": {
    "family": {
      "sans": [
        "IBM Plex Sans KR",
        "system-ui",
        "-apple-system",
        "Apple SD Gothic Neo",
        "Malgun Gothic",
        "sans-serif"
      ],
      "mono": [
        "IBM Plex Mono",
        "ui-monospace",
        "Menlo",
        "monospace"
      ]
    },
    "size": {
      "tiny": 11,
      "small": 12,
      "dense": 13,
      "body": 15,
      "section": 20,
      "page": 28
    },
    "weight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600
    },
    "lineHeight": {
      "base": 1.45,
      "body": 1.5
    },
    "numeric": "tabular-nums"
  },
  "radius": {
    "card": 6,
    "control": 6,
    "chip": 4,
    "pill": 9,
    "band": 5
  },
  "spacing": {
    "1": 4,
    "2": 6,
    "3": 8,
    "4": 10,
    "5": 12,
    "6": 16,
    "7": 24,
    "8": 32,
    "9": 48,
    "10": 56
  },
  "layout": {
    "rail": 220,
    "panel": 380,
    "cardGap": 10,
    "laneGap": 56,
    "laneMin": 190,
    "laneMax": 300,
    "collapsedLane": 44,
    "kindBand": 4,
    "weftAttachY": 18
  },
  "stroke": {
    "weftIdle": 1.25,
    "weftHighlight": 1.75,
    "knot": 1,
    "pulse": 3,
    "pulseHead": 6,
    "pulseGlow": 10,
    "border": 1,
    "borderSelected": 1.5,
    "focusRing": 2,
    "pulseTail": 60
  },
  "opacity": {
    "weftIdle": 0.45,
    "weftDim": 0.08,
    "cardDim": 0.32,
    "pulseGlow": 0.25
  },
  "filter": {
    "cardDimSaturate": 0.6
  },
  "motion": {
    "hover": {
      "duration": 120,
      "easing": "ease"
    },
    "panelSlide": {
      "duration": 180,
      "easing": "ease-out"
    },
    "flipSlide": {
      "duration": 220,
      "easing": "ease-out"
    },
    "flipFadeOut": {
      "duration": 120,
      "easing": "linear"
    },
    "flipFadeIn": {
      "duration": 160,
      "delay": 80,
      "easing": "linear"
    },
    "pulseHop": {
      "min": 350,
      "max": 700,
      "floor": 200,
      "easing": "ease-in-out"
    },
    "pulsePause": 1500,
    "pulseFlash": 400,
    "pulseRunMax": 6000
  }
}