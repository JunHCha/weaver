{
  "$defs": {
    "NonEmpty": {
      "pattern": "\\S",
      "type": "string"
    },
    "Revision": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "$id": "urn:weaver:schema:v2:Verdict",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "edited_body": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "edit"
          }
        }
      },
      "then": {
        "properties": {
          "edited_body": {
            "type": "string"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "feedback": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "action": {
            "const": "feedback"
          }
        }
      },
      "then": {
        "properties": {
          "feedback": {
            "type": "string"
          }
        }
      }
    }
  ],
  "description": "A user's action on one exact review package revision.",
  "properties": {
    "action": {
      "enum": [
        "approve",
        "edit",
        "feedback",
        "reject"
      ],
      "title": "Action",
      "type": "string"
    },
    "answers": {
      "items": {
        "$ref": "#/$defs/NonEmpty"
      },
      "title": "Answers",
      "type": "array"
    },
    "edited_body": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonEmpty"
        },
        {
          "type": "null"
        }
      ]
    },
    "feedback": {
      "anyOf": [
        {
          "$ref": "#/$defs/NonEmpty"
        },
        {
          "type": "null"
        }
      ]
    },
    "package_id": {
      "$ref": "#/$defs/NonEmpty"
    },
    "revision": {
      "$ref": "#/$defs/Revision"
    },
    "schema_version": {
      "const": 2,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "revision",
    "action",
    "answers",
    "edited_body",
    "feedback"
  ],
  "title": "Verdict",
  "type": "object"
}
