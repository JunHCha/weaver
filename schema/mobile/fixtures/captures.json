        "method": "GET",
        "path": "/mobile/v1/captures/cap_01ARZ3NDEKTSV4RRFFQ69G5FA0/receipt",
        "headers": {
          "authorization": "Bearer <token>"
        }
      },
      "response": {
        "status": 404,
