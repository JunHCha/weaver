{
  "contract_version": 1,
  "group": "changes_kinds",
  "description": "Feed kinds added after the first phone build: alert, pipeline, wiki. A phone must name them with ?kinds=; without it only review/action/fabric arrive.",
  "cases": [
    {
      "name": "legacy_snapshot",
      "request": {
        "method": "GET",
        "path": "/mobile/v1/changes",
        "headers": {
          "authorization": "Bearer <token>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "feed_epoch": "ep_00000000000000000000000000000001",
          "items": [
            {
              "seq": 1,
              "kind": "fabric",
              "id": "threads",
              "revision": 0,
              "op": "upsert",
              "body": null
            }
          ],
          "next_cursor": "ep_00000000000000000000000000000001.4",
          "has_more": false
        }
      },
      "note": "An older build sends no kinds and never sees alert/pipeline/wiki, even when the server routes them over HTTP."
    },
    {
      "name": "negotiated_snapshot",
      "request": {
        "method": "GET",
        "path": "/mobile/v1/changes",
        "query": {
          "kinds": "review,action,alert,pipeline,wiki,fabric"
        },
        "headers": {
          "authorization": "Bearer <token>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "feed_epoch": "ep_00000000000000000000000000000001",
          "items": [
            {
              "seq": 1,
              "kind": "fabric",
              "id": "threads",
              "revision": 0,
              "op": "upsert",
              "body": null
            },
            {
              "seq": 2,
              "kind": "alert",
              "id": "alt_01ARZ3NDEKTSV4RRFFQ69G5FA0",
              "revision": null,
              "op": "upsert",
              "body": null
            },
            {
              "seq": 3,
              "kind": "pipeline",
              "id": "src_00000000000000000000000001",
              "revision": 1,
              "op": "upsert",
              "body": {
                "etag": "\"cc8ffec9b70426e3bb2c71eaa3dea8fd42c5804c0f8d1bda790106919129844d\""
              }
            },
            {
              "seq": 4,
              "kind": "wiki",
              "id": "ab279fb0c227d5feeb582f1f",
              "revision": null,
              "op": "upsert",
              "body": {
                "etag": "\"d75dfcdad52310980ce7c330a507863f573d96699dcc83e0ea4f32476608f676\""
              }
            }
          ],
          "next_cursor": "ep_00000000000000000000000000000001.4",
          "has_more": false
        }
      },
      "note": "Alert/pipeline/wiki entries are hints: fetch the body from /alerts, /read/pipeline or /read/wiki. alert needs review scope; pipeline, wiki and fabric need read."
    },
    {
      "name": "unknown_kind_ignored",
      "request": {
        "method": "GET",
        "path": "/mobile/v1/changes",
        "query": {
          "kinds": "fabric,hologram"
        },
        "headers": {
          "authorization": "Bearer <token>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "feed_epoch": "ep_00000000000000000000000000000001",
          "items": [
            {
              "seq": 1,
              "kind": "fabric",
              "id": "threads",
              "revision": 0,
              "op": "upsert",
              "body": null
            }
          ],
          "next_cursor": "ep_00000000000000000000000000000001.4",
          "has_more": false
        }
      },
      "note": "Kinds the server does not know are ignored so a newer phone still works."
    },
    {
      "name": "alert_body_expired",
      "request": {
        "method": "GET",
        "path": "/mobile/v1/changes",
        "query": {
          "kinds": "alert",
          "cursor": "ep_00000000000000000000000000000001.4"
        },
        "headers": {
          "authorization": "Bearer <token>"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "feed_epoch": "ep_00000000000000000000000000000001",
          "items": [
            {
              "seq": 5,
              "kind": "alert",
              "id": "alt_01ARZ3NDEKTSV4RRFFQ69G5FA0",
              "revision": null,
              "op": "tombstone",
              "body": null
            }
          ],
          "next_cursor": "ep_00000000000000000000000000000001.5",
          "has_more": false
        }
      },
      "note": "Expiry of a retained body tombstones the alert hint. Leaving a route back to files never writes a tombstone: the kind just disappears from the feed."
    }
  ]
}
