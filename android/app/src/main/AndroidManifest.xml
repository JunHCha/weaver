<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Feature permissions. None is requested at launch; each feature asks on demand
         and the home screen stays usable when any of them is denied. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />

    <!-- Originals and review data must never leave the device through backup or transfer:
         allowBackup=false stops cloud backup, fullBackupContent covers Android 8-11 and
         dataExtractionRules also excludes Android 12+ device-to-device transfer. -->
    <!-- Lets auto share open the Samsung Voice Recorder (package visibility, Android 11+). -->
    <queries>
        <package android:name="com.sec.android.app.voicenote" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Weaver"
        tools:targetApi="36">
        <receiver android:name=".widget.ReviewWidgetReceiver" android:exported="false"
            android:label="@string/review_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/review_widget_info" />
        </receiver>
        <activity android:name=".widget.WidgetReviewActivity" android:exported="false" />
        <!-- Off until the user enables it in system accessibility settings; see auto_share_service.xml. -->
        <service
            android:name=".shepherd.autoshare.WeaverAutoShareService"
            android:exported="true"
            android:label="@string/auto_share_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/auto_share_service" />
        </service>
        <activity android:name=".shepherd.ShareActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/txt" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="application/txt" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
