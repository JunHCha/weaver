{
    "/$defs/NonEmpty/pattern": "\\S",
    "/$defs/NonEmpty/type": "string",
    "/$defs/Revision/minimum": 1,
    "/$defs/Revision/type": "integer",
    "/additionalProperties": false,
    "/allOf": [
        {
            "if": {
                "properties": {
                    "action": {
                        "const": "feedback"
                    }
                }
            },
            "then": {
                "properties": {
                    "feedback": {
                        "type": "string"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "action": {
                        "const": "reject"
                    }
                }
            },
            "then": {
                "properties": {
                    "feedback": {
                        "type": "null"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "action": {
                        "const": "edit"
                    }
                }
            },
            "then": {
                "properties": {
                    "edited_body": {
                        "type": "string"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "action": {
                        "enum": [
                            "approve",
                            "reject"
                        ]
                    }
                }
            },
            "then": {
                "properties": {
                    "edited_body": {
                        "type": "null"
                    }
                }
            }
        }
    ],
    "/properties/action/enum": [
        "approve",
        "edit",
        "feedback",
        "reject"
    ],
    "/properties/action/type": "string",
    "/properties/answers/type": "array",
    "/properties/edited_body/anyOf": [
        {
            "$ref": "#/$defs/NonEmpty"
        },
        {
            "type": "null"
        }
    ],
    "/properties/feedback/anyOf": [
        {
            "$ref": "#/$defs/NonEmpty"
        },
        {
            "type": "null"
        }
    ],
    "/properties/schema_version/const": 2,
    "/properties/schema_version/type": "integer",
    "/required": [
        "schema_version",
        "package_id",
        "revision",
        "action",
        "answers",
        "edited_body",
        "feedback"
    ],
    "/type": "object"
}
